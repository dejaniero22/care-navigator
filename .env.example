# Synthetic local development only. Source your private .env before starting.
DJANGO_DEBUG=true
# Set a private random value for non-demo hosting. Never commit real credentials.
DJANGO_SECRET_KEY=synthetic-local-development-only
PGHOST=/workspace/care-navigator-runtime
PGPORT=5432
PGDATABASE=care_navigator
PGUSER=agent
VERIFICATION_STALE_DAYS=30
# Configurable wording requires clinical review before live use.
EMERGENCY_INSTRUCTIONS='If you think you have an emergency, contact local emergency services. Prototype wording awaits clinical review. This app is not monitored for emergencies.'
